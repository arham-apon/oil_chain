{
 "uid": "fsp-intelligence",
 "title": "Intelligence & Decisions",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "tags": [
  "fsp",
  "simulated"
 ],
 "panels": [
  {
   "id": 1,
   "title": "Decisions by origin/status",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (origin, status) (increase(decisions_total[5m]))",
     "legendFormat": "{{origin}} {{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
