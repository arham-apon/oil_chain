{
 "uid": "fsp-loadtest",
 "title": "Load Test",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "tags": [
  "fsp",
  "simulated"
 ],
 "panels": [
  {
   "id": 1,
   "title": "RPS by route",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service, route) (rate(http_requests_total[30s]))",
     "legendFormat": "{{service}} {{route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "title": "p50/p95/p99 by service",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum by (le, service) (rate(http_request_duration_seconds_bucket[30s])))",
     "legendFormat": "{{service}}"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[30s])))",
     "legendFormat": "{{service}}"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_request_duration_seconds_bucket[30s])))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Error rate %",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(rate(http_requests_total{status=~\"5..\"}[30s])) / clamp_min(sum(rate(http_requests_total[30s])), 1e-9)",
     "legendFormat": "5xx %"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "title": "CPU % per container",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".+\"}[30s]))",
     "legendFormat": "{{name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   }
  }
 ]
}