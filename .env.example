# Simulator
SIMULATOR_URL=http://simulator-api:8000
SIMULATION_SPEED=8
TICK_MINUTES=15
SIMULATOR_START_MODE=paused
# Postgres
POSTGRES_DB=fuel_platform
POSTGRES_USER=fuel_admin
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://fuel_admin:change-me@postgres:5432/fuel_platform
REDIS_URL=redis://redis:6379/0
# AI (cloud only)
TYPESAFE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
JEV_MODEL=jev-latest
# Decision policy
DECISION_INTERVAL_TICKS=4
AUTO_APPROVE_NOUL_MIN=0.85
AUTO_APPROVE_URGENCY_MAX=4.5
STAGED_DECISION_TTL_TICKS=16
MIN_LOT_LITERS=500
# per_route_per_cycle | per_allocation
ROUTE_CAP_MODE=per_route_per_cycle
DEPOT_CONSTRAINT_DERATE=0.5
JEV_TIMEOUT_MS=600
GEMINI_TIMEOUT_MS=3000
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_SECONDS=30
SIM_HTTP_TIMEOUT_S=3.0
DEMO_CONTROLS=true
GRAFANA_ADMIN_PASSWORD=change-me
# Tunables (non-secret, all have defaults in fsp_shared.config)
LOG_LEVEL=INFO
HORIZON_TICKS=24
COVER_TICKS=32
SYNC_MAX_HZ=4
SNAPSHOT_RETENTION_TICKS=2000
# forecast-svc model artifacts
MODEL_DIR=/models
# Chaos: when true, AI clients use an invalid key to exercise fallbacks
CHAOS_BAD_AI_KEYS=false
# Host port overrides (container ports never change). Windows/Hyper-V reserves 8081-8180 and 5433-5532 on some
# machines, which makes Docker fail to publish 8101-8104 / 8081: set e.g. INGESTION_HOST_PORT=18101 in .env.
# INGESTION_HOST_PORT=8101
# FORECAST_HOST_PORT=8102
# DECISION_HOST_PORT=8103
# COGNITIVE_HOST_PORT=8104
# POSTGRES_HOST_PORT=55432
# REDIS_HOST_PORT=6379
